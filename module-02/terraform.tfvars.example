# =============================================================================
# Module 02: Example Variables File
# =============================================================================
# Copy this file to terraform.tfvars or use environment-specific files like
# dev.tfvars, test.tfvars, etc.
#
# Usage:
#   terraform plan -var-file="dev.tfvars"
#   terraform apply -var-file="dev.tfvars"
# =============================================================================

# -----------------------------------------------------------------------------
# General Settings
# -----------------------------------------------------------------------------

# Environment name - determines naming and tagging
# Allowed values: dev, test, staging, prod
environment = "dev"

# Azure region for deployment
location = "Central US"

# Project name prefix for resources (3-15 lowercase alphanumeric)
project_name = "tftraining"

# -----------------------------------------------------------------------------
# App Service Configuration
# -----------------------------------------------------------------------------

# Web application name suffix
app_name = "webapp"

# App Service Plan SKU
# Options: F1 (Free), B1/B2/B3 (Basic), S1/S2/S3 (Standard), P1v2/P2v2/P3v2 (Premium)
appservice_plan_sku = "F1"

# Runtime stack for the web app
# Examples: NODE|18-lts, PYTHON|3.11, DOTNETCORE|8.0
runtime_stack = "NODE|18-lts"

# Enable System Assigned Managed Identity
enable_managed_identity = true

# -----------------------------------------------------------------------------
# Application Settings (Environment Variables)
# -----------------------------------------------------------------------------

app_settings = {
  "WEBSITE_NODE_DEFAULT_VERSION" = "~18"
  # Add your app-specific settings here
  # "MY_SETTING" = "my-value"
  
  # IMPORTANT: Never put secrets here!
  # Use Key Vault references or managed identity instead:
  # "MY_SECRET" = "@Microsoft.KeyVault(SecretUri=https://my-kv.vault.azure.net/secrets/my-secret/)"
}

# -----------------------------------------------------------------------------
# Sample App Deployment
# -----------------------------------------------------------------------------

# Set to true to deploy the sample Node.js app after infrastructure creation
deploy_sample_app = false

# -----------------------------------------------------------------------------
# Tags
# -----------------------------------------------------------------------------

# Owner email or team name
owner = "your-team@example.com"

# Cost center for billing
cost_center = "training-budget"

# Additional custom tags
additional_tags = {
  "Purpose" = "Training"
  "Tier"    = "Learning"
}
